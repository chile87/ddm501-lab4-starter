{
  "title": "System Metrics Dashboard",
  "uid": "system-metrics",
  "schemaVersion": 38,
  "refresh": "10s",
  "time": {"from": "now-1h", "to": "now"},
  "tags": ["api", "system", "ddm501"],
  "panels": [
    {"id": 1, "title": "Request Rate", "type": "timeseries", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}, "targets": [{"expr": "rate(http_requests_total[5m])", "legendFormat": "{{method}} {{endpoint}}", "refId": "A"}]},
    {"id": 2, "title": "Request Latency (P95)", "type": "timeseries", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}, "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket[5m])))", "legendFormat": "p95", "refId": "A"}]},
    {"id": 3, "title": "Error Rate", "type": "stat", "gridPos": {"h": 6, "w": 8, "x": 0, "y": 8}, "fieldConfig": {"defaults": {"unit": "percent"}}, "targets": [{"expr": "rate(http_requests_total{status=~\"5..\"}[5m]) / rate(http_requests_total[5m]) * 100", "refId": "A"}]},
    {"id": 4, "title": "Status Code Distribution", "type": "piechart", "gridPos": {"h": 6, "w": 8, "x": 8, "y": 8}, "targets": [{"expr": "sum by (status) (rate(http_requests_total[5m]))", "legendFormat": "{{status}}", "refId": "A"}]},
    {"id": 5, "title": "Requests by Endpoint", "type": "table", "gridPos": {"h": 6, "w": 8, "x": 16, "y": 8}, "targets": [{"expr": "sum by (endpoint) (rate(http_requests_total[5m]))", "format": "table", "refId": "A"}]}
  ]
}
