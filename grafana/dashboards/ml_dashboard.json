{
  "title": "ML Metrics Dashboard",
  "uid": "ml-metrics",
  "schemaVersion": 38,
  "refresh": "10s",
  "time": {"from": "now-1h", "to": "now"},
  "tags": ["ml", "model", "ddm501"],
  "panels": [
    {"id": 1, "title": "Model Status", "type": "stat", "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0}, "targets": [{"expr": "ml_model_loaded", "refId": "A"}]},
    {"id": 2, "title": "Average Prediction", "type": "gauge", "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0}, "fieldConfig": {"defaults": {"min": 1, "max": 5}}, "targets": [{"expr": "histogram_quantile(0.5, sum by (le) (rate(ml_prediction_value_bucket[5m])))", "refId": "A"}]},
    {"id": 3, "title": "Prediction Rate", "type": "stat", "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0}, "targets": [{"expr": "rate(ml_predictions_total[5m])", "refId": "A"}]},
    {"id": 4, "title": "Prediction Errors", "type": "timeseries", "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0}, "targets": [{"expr": "rate(ml_prediction_errors_total[5m])", "legendFormat": "{{error_type}}", "refId": "A"}]},
    {"id": 5, "title": "Prediction Latency (P95)", "type": "timeseries", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4}, "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(ml_prediction_duration_seconds_bucket[5m])))", "legendFormat": "p95", "refId": "A"}]},
    {"id": 6, "title": "Prediction Value Distribution", "type": "timeseries", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4}, "targets": [{"expr": "rate(ml_prediction_value_bucket[5m])", "legendFormat": "le={{le}}", "refId": "A"}]},
    {"id": 7, "title": "Model Info", "type": "table", "gridPos": {"h": 6, "w": 24, "x": 0, "y": 12}, "targets": [{"expr": "ml_model_info", "format": "table", "refId": "A"}]}
  ]
}
